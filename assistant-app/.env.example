# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required to start.

# Anthropic (required) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Linear (optional) — Linear > Settings > API > Personal API keys
LINEAR_API_KEY=

# GitHub (optional) — https://github.com/settings/tokens (classic, scopes: repo, read:user)
GITHUB_TOKEN=
GITHUB_REPOS=SinhaShambhavi/tic-tac-toe

# Google (optional) — see README: download OAuth credentials.json into data/
# No env var needed; token is stored in data/google_token.json after first auth.

# Server
PORT=8756
